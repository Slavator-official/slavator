<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Slavator</string>
    <key>CFBundleDisplayName</key>
    <string>Славатор</string>
    <key>CFBundleExecutable</key>
    <string>slavator</string>
    <key>CFBundleIdentifier</key>
    <string>ru.slavator.app</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>25.10</string>
    <key>CFBundleVersion</key>
    <string>25.10</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <!-- Должно совпадать с целью сборки в build_app.sh. Стояло 14.0, а
         приложение собрано под 14.4 и требует Core Audio process taps
         (macOS 14.2). На системе постарее оно падало при запуске: класс
         CATapDescription подтягивается при старте, и без него старт
         невозможен. С честной версией система откажет понятным окном. -->
    <key>LSMinimumSystemVersion</key>
    <string>14.2</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Славатор. Обработка встреч выполняется локально.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Чтобы записывать встречу с микрофона.</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>Чтобы слышать всех участников звонка при записи встречи.</string>
    <key>NSDesktopFolderUsageDescription</key>
    <string>Нужен доступ к записям встреч, которые вы выбираете вручную.</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>Нужен доступ к записям встреч, которые вы выбираете вручную.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>Сюда сохраняются результаты обработки встреч.</string>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Запись встречи</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.movie</string>
                <string>public.audio</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
